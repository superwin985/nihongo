[
 {
  "t": "00:00",
  "text": "大家学英文�"
 },
 {
  "t": "00:00",
  "text": "脑子里是不是总会不由自主的先吧"
 },
 {
  "t": "00:02",
  "text": "它翻译成中文的"
 },
 {
  "t": "00:04",
  "text": "比如说你看到Apple总会想到苹果"
 },
 {
  "t": "00:05",
  "text": "看到Carr就会想到车子"
 },
 {
  "t": "00:07",
  "text": "我们必须承认"
 },
 {
  "t": "00:08",
  "text": "用母语当作强量来学外语"
 },
 {
  "t": "00:10",
  "text": "好处是非常明显的"
 },
 {
  "t": "00:12",
  "text": "它可以让你非常快地上手"
 },
 {
  "t": "00:13",
  "text": "甚至帮你准备亚斯多课、应付生学和求职"
 },
 {
  "t": "00:19",
  "text": "但是对于绝大多数普通人来说"
 },
 {
  "t": "00:22",
  "text": "这种凡事都要经过母语翻译的习惯"
 },
 {
  "t": "00:24",
  "text": "可能会留下一个极其致命的后遍语症"
 },
 {
  "t": "00:27",
  "text": "就是效率太慢"
 },
 {
  "t": "00:28",
  "text": "我们10年寒窗"
 },
 {
  "t": "00:30",
  "text": "依然可能是一个一脱离考卷"
 },
 {
  "t": "00:32",
  "text": "就原形必路的外语、龙子跟哑"
 },
 {
  "t": "00:35",
  "text": "之前的节目我们有讲过张同玩的"
 },
 {
  "t": "00:37",
  "text": "One hundred Ls就是一部电影100次"
 },
 {
  "t": "00:40",
  "text": "疯狂照的读照的念最后能够脱口而出"
 },
 {
  "t": "00:42",
  "text": "据说很多人练完以后说很有效"
 },
 {
  "t": "00:44",
  "text": "确实啊"
 },
 {
  "t": "00:45",
  "text": "因为你背过的那些场景"
 },
 {
  "t": "00:47",
  "text": "你说的很溜翻译也变得好听了"
 },
 {
  "t": "00:58",
  "text": "口香鸡肉啊终于记住了英文的形状"
 },
 {
  "t": "01:01",
  "text": "但是现实却很骨感"
 },
 {
  "t": "01:03",
  "text": "现实就是你走出房间"
 },
 {
  "t": "01:05",
  "text": "遇到老外随便跟他聊天"
 },
 {
  "t": "01:07",
  "text": "或者你看YouTube"
 },
 {
  "t": "01:08",
  "text": "不信你自己把中文字幕关掉"
 },
 {
  "t": "01:12",
  "text": "你试一下"
 },
 {
  "t": "01:12",
  "text": "你是不是又瞬间听不懂了"
 },
 {
  "t": "01:15",
  "text": "为什么会这样呢"
 },
 {
  "t": "01:15",
  "text": "因为你练过的电影台词"
 },
 {
  "t": "01:17",
  "text": "早就已经变成了熟悉的内容"
 },
 {
  "t": "01:19",
  "text": "但是真实的"
 },
 {
  "t": "01:19",
  "text": "你会感觉到"
 },
 {
  "t": "01:21",
  "text": "你自己的口香鸡肉"
 },
 {
  "t": "01:22",
  "text": "你会感觉到"
 },
 {
  "t": "01:23",
  "text": "你自己的口香鸡肉"
 },
 {
  "t": "01:25",
  "text": "你会感觉到"
 },
 {
  "t": "01:26",
  "text": "你自己的口香�肉"
 },
 {
  "t": "01:28",
  "text": "就已经变成了熟悉的内容"
 },
 {
  "t": "01:30",
  "text": "但是真实的对话是不一样的"
 },
 {
  "t": "01:32",
  "text": "老外并不会按照你背过的台词"
 },
 {
  "t": "01:34",
  "text": "跟你聊天"
 },
 {
  "t": "01:35",
  "text": "更不会等你在脑子里慢慢翻译"
 },
 {
  "t": "01:37",
  "text": "他们可能会突然换个话题"
 },
 {
  "t": "01:39",
  "text": "或者是使用一些你没有听过的表达"
 },
 {
  "t": "01:41",
  "text": "或者是把一整串单字放在一起"
 },
 {
  "t": "01:43",
  "text": "用自然语速"
 },
 {
  "t": "01:44",
  "text": "非常快的说出来"
 },
 {
  "t": "01:45",
  "text": "So I thought you put down your chances"
 },
 {
  "t": "01:47",
  "text": "这个时候啊"
 },
 {
  "t": "01:48",
  "text": "你背过认识的那些单字"
 },
 {
  "t": "01:50",
  "text": "就没有办法在真实的语速下面"
 },
 {
  "t": "01:52",
  "text": "直接辨识出他们"
 },
 {
  "t": "01:54",
  "text": "你听懂了上一句"
 },
 {
  "t": "01:55",
  "text": "下一句其实早就飘过去了"
 },
 {
  "t": "01:57",
  "text": "这是为什么很多人练了很多遍"
 },
 {
  "t": "01:59",
  "text": "One hundred else听说"
 },
 {
  "t": "02:01",
  "text": "但是遇到真人还是会出现假性流利"
 },
 {
  "t": "02:03",
  "text": "虽然我们嘴巴记住了英文怎么说"
 },
 {
  "t": "02:05",
  "text": "但是耳朵啊"
 },
 {
  "t": "02:07",
  "text": "就还没有学会英文怎么听"
 },
 {
  "t": "02:09",
  "text": "今天我们要聊另外一个韩国狠人"
 },
 {
  "t": "02:11",
  "text": "叫郑赞荣"
 },
 {
  "t": "02:13",
  "text": "他最值得研究的地方"
 },
 {
  "t": "02:15",
  "text": "不是他提出了一套不同的英语绝绝方法"
 },
 {
  "t": "02:17",
  "text": "而是他直接挑战了一个"
 },
 {
  "t": "02:19",
  "text": "很多人从小就深信不疑的观念"
 },
 {
  "t": "02:21",
  "text": "学外语就一定要先翻译成自己的母语"
 },
 {
  "t": "02:23",
  "text": "有人把他的理念理解成为one hundred else的前转"
 },
 {
  "t": "02:25",
  "text": "one hundred else 强调"
 },
 {
  "t": "02:27",
  "text": "反复聆听和模仿"
 },
 {
  "t": "02:29",
  "text": "让你把一段英文列到熟练"
 },
 {
  "t": "02:31",
  "text": "但是郑� 赞 荣的思路更进一步"
 },
 {
  "t": "02:33",
  "text": "在你急着张口之前"
 },
 {
  "t": "02:35",
  "text": "先训练自己直接辨识外语的声音"
 },
 {
  "t": "02:37",
  "text": "不要每次都依赖母语"
 },
 {
  "t": "02:39",
  "text": "替你完成理解"
 },
 {
  "t": "02:41",
  "text": "郑 赞 荣当年去德国留学"
 },
 {
  "t": "02:43",
  "text": "发现自己苦学10年的外语"
 },
 {
  "t": "02:45",
  "text": "在真实的语速面前"
 },
 {
  "t": "02:47",
  "text": "依然是处处碰壁"
 },
 {
  "t": "02:49",
  "text": "最后他被逼入绝境"
 },
 {
  "t": "02:51",
  "text": "于是开始重新思考自己的学习方式"
 },
 {
  "t": "02:53",
  "text": "后来他把这套理念写成了一本书"
 },
 {
  "t": "02:55",
  "text": "但在韩国引起了巨大的关注"
 },
 {
  "t": "02:57",
  "text": "还进入了华语和日本的出版市场"
 },
 {
  "t": "02:59",
  "text": "让大量英语学习者"
 },
 {
  "t": "03:01",
  "text": "开始重新思考自己熟悉的学学方式"
 },
 {
  "t": "03:03",
  "text": "他到底有什么魔力呢"
 },
 {
  "t": "03:05",
  "text": "为什么一个原本从事警官设计"
 },
 {
  "t": "03:07",
  "text": "与环境开发的人"
 },
 {
  "t": "03:09",
  "text": "会因为一本英语学习书"
 },
 {
  "t": "03:11",
  "text": "引起这么大的反响呢"
 },
 {
  "t": "03:13",
  "text": "他提出的海绵盲听法"
 },
 {
  "t": "03:15",
  "text": "究竟能不能帮助我们突破听力的瓶颈"
 },
 {
  "t": "03:17",
  "text": "今天这支影片"
 },
 {
  "t": "03:19",
  "text": "我会直接帮你解决三个最硬核的问题"
 },
 {
  "t": "03:21",
  "text": "第一个 郑赞主张减少双语资点的输入"
 },
 {
  "t": "03:23",
  "text": "这个跟我们之前讲过的"
 },
 {
  "t": "03:25",
  "text": "Catalorm"
 },
 {
  "t": "03:26",
  "text": "以及韩语里希的直接阅读法"
 },
 {
  "t": "03:28",
  "text": "难道就没有矛盾吗"
 },
 {
  "t": "03:30",
  "text": "第二个 就是绝对盲听"
 },
 {
  "t": "03:32",
  "text": "完全不碰中文"
 },
 {
  "t": "03:33",
  "text": "那听不懂我们该怎么办"
 },
 {
  "t": "03:35",
  "text": "因为听都听不清楚大脑"
 },
 {
  "t": "03:37",
  "text": "到底在学什么呢"
 },
 {
  "t": "03:39",
  "text": "第三个就是 纯外语听力对材料的要求极高"
 },
 {
  "t": "03:41",
  "text": "如果你选错了 就等于是在听天书"
 },
 {
  "t": "03:43",
  "text": "那我们到底应该怎么选财"
 },
 {
  "t": "03:45",
  "text": "怎么实操呢"
 },
 {
  "t": "03:47",
  "text": "最后我还会把这套方法整理成为可以照着执行的30天的训练流程"
 },
 {
  "t": "03:50",
  "text": "OK 我们直接开始"
 },
 {
  "t": "03:52",
  "text": "时间回到1984年"
 },
 {
  "t": "03:54",
  "text": "当时的郑赞荣他是韩国首尔大学"
 },
 {
  "t": "03:56",
  "text": "造景系毕业的高材生"
 },
 {
  "t": "03:58",
  "text": "他在韩国军队里耽误海军中位"
 },
 {
  "t": "04:00",
  "text": "推以后又进了大语集团当工程师"
 },
 {
  "t": "04:02",
  "text": "妥妥的人生赢家"
 },
 {
  "t": "04:10",
  "text": "这一年 他决定挑战自我"
 },
 {
  "t": "04:12",
  "text": "飞去德国留学"
 },
 {
  "t": "04:14",
  "text": "在出国之前 郑赞荣对自己的德语能力是非常自信的"
 },
 {
  "t": "04:17",
  "text": "他心里想 就凭我这十几年做题家列出来的底子"
 },
 {
  "t": "04:20",
  "text": "到了德国还不是可以横了走吗"
 },
 {
  "t": "04:22",
  "text": "结果飞机一落地 德国人一张口"
 },
 {
  "t": "04:24",
  "text": "还是一样的剧情啊"
 },
 {
  "t": "04:26",
  "text": "他在脑袋里简直就像一台失控的碎纸机"
 },
 {
  "t": "04:29",
  "text": "霹雳啪啦的一顿高速输出"
 },
 {
  "t": "04:31",
  "text": "结果他一个字都听不懂"
 },
 {
  "t": "04:33",
  "text": "他去超市买了个面包"
 },
 {
  "t": "04:35",
  "text": "他居然听不懂 店员在问他什么"
 },
 {
  "t": "04:37",
  "text": "就像一个傻子样  站着开始筆划手脚"
 },
 {
  "t": "04:39",
  "text": "坐在大学教室里面听德语教授讲课"
 },
 {
  "t": "04:41",
  "text": "完全就是像听天书一样"
 },
 {
  "t": "04:43",
  "text": "可想而知 他马上就崩溃了"
 },
 {
  "t": "04:45",
  "text": "郑赞荣发现了一个极其殘酷的真相"
 },
 {
  "t": "04:47",
  "text": "他的韩国苦读了十几年的外语"
 },
 {
  "t": "04:49",
  "text": "也就是德语 学的根本不是语言"
 },
 {
  "t": "04:51",
  "text": "而是一个密码学"
 },
 {
  "t": "04:53",
  "text": "因为他们只会考试"
 },
 {
  "t": "05:17",
  "text": "郑赞荣突然醒悟了"
 },
 {
  "t": "05:19",
  "text": "语言从来不是用来学的"
 },
 {
  "t": "05:21",
  "text": "语言是用来习惯"
 },
 {
  "t": "05:23",
  "text": "他回想了 因而是怎么习惯语言的"
 },
 {
  "t": "05:25",
  "text": "他们先是有生意的输入"
 },
 {
  "t": "05:27",
  "text": "然后才去寻找生意的意义"
 },
 {
  "t": "05:29",
  "text": "而像郑赞荣一样"
 },
 {
  "t": "05:31",
  "text": "我们的亚洲人学外语完全就是倒过来的"
 },
 {
  "t": "05:33",
  "text": "我们先是背会了意义"
 },
 {
  "t": "05:35",
  "text": "然后进行母语翻译"
 },
 {
  "t": "05:37",
  "text": "然后再去硬配上所有的生意"
 },
 {
  "t": "05:39",
  "text": "于是这哥们做了一个极其疯狂的决定"
 },
 {
  "t": "05:41",
  "text": "他拉开了抽屉把里面"
 },
 {
  "t": "05:43",
  "text": "所有的韩字典"
 },
 {
  "t": "05:45",
  "text": "他开始用绝对盲听学习德语"
 },
 {
  "t": "05:47",
  "text": "也就是绝对不碰母语翻译"
 },
 {
  "t": "05:49",
  "text": "也就是不用韩语翻译"
 },
 {
  "t": "05:51",
  "text": "他就像一块干别的海绵一样"
 },
 {
  "t": "05:53",
  "text": "把自己直接扔进了德语的声音汪洋里面"
 },
 {
  "t": "05:55",
  "text": "首先没有字幕"
 },
 {
  "t": "05:57",
  "text": "然后没有语言 听不懂就硬听下去"
 },
 {
  "t": "05:59",
  "text": "遇到真的过不去的看"
 },
 {
  "t": "06:01",
  "text": "他只查德德字典"
 },
 {
  "t": "06:03",
  "text": "这无疑是一个巨大的精神折磨"
 },
 {
  "t": "06:05",
  "text": "初期简直是生不如死"
 },
 {
  "t": "06:07",
  "text": "但是后来奇迹发生了"
 },
 {
  "t": "06:09",
  "text": "这个刚到德国时候连满面包都飞进了韩国人"
 },
 {
  "t": "06:11",
  "text": "居然一次性高分通过了"
 },
 {
  "t": "06:13",
  "text": "低于难度的德国官方"
 },
 {
  "t": "06:15",
  "text": "语文资格考试"
 },
 {
  "t": "06:17",
  "text": "正式取得了入学资格"
 },
 {
  "t": "06:19",
  "text": "后来他一路学习开挂"
 },
 {
  "t": "06:21",
  "text": "拿下了多特蒙德大学的硕士"
 },
 {
  "t": "06:23",
  "text": "以及汉多威大学的博士学位"
 },
 {
  "t": "06:25",
  "text": "听到这儿你以为故事就结束了吗"
 },
 {
  "t": "06:27",
  "text": "才没有真正的高光时刻才刚开始"
 },
 {
  "t": "06:29",
  "text": "90年代末"
 },
 {
  "t": "06:31",
  "text": "郑赞荣回到了韩国"
 },
 {
  "t": "06:33",
  "text": "成为顶级的警官设计师"
 },
 {
  "t": "06:35",
  "text": "还当上了大学的教授"
 },
 {
  "t": "06:37",
  "text": "当时的韩国刚刚经历了1997年的亚洲金融风暴"
 },
 {
  "t": "06:39",
  "text": "整个国家都在疯狂的推动全球化"
 },
 {
  "t": "06:41",
  "text": "企业招聘把英语能力看作生死标准"
 },
 {
  "t": "06:43",
  "text": "无数韩国年年死科单字书被文法考多亿"
 },
 {
  "t": "06:47",
  "text": "花了天文数字的补习费"
 },
 {
  "t": "06:49",
  "text": "见到老外依然是个哑巴"
 },
 {
  "t": "06:51",
  "text": "郑赞荣实在是看不下去了"
 },
 {
  "t": "06:53",
  "text": "他觉得这个就像当年的自己一样"
 },
 {
  "t": "06:55",
  "text": "于是在1999年的7月份"
 },
 {
  "t": "06:57",
  "text": "他根据自己在德国学习德语的经验"
 },
 {
  "t": "06:59",
  "text": "把这条逻辑用在了英语上"
 },
 {
  "t": "07:01",
  "text": "写出了一本书"
 },
 {
  "t": "07:02",
  "text": "说明极其的夸张"
 },
 {
  "t": "07:03",
  "text": "简直就是对着整个传统教育体制"
 },
 {
  "t": "07:05",
  "text": "数终止"
 },
 {
  "t": "07:06",
  "text": "名字叫做"
 },
 {
  "t": "07:07",
  "text": "千万别学英语"
 },
 {
  "t": "07:09",
  "text": "这本书一出版直接在韩国炸了"
 },
 {
  "t": "07:11",
  "text": "他连续一年霸占了韩国图书总绑的冠军"
 },
 {
  "t": "07:14",
  "text": "在韩国这个人口"
 },
 {
  "t": "07:15",
  "text": "只有几千万的国家"
 },
 {
  "t": "07:17",
  "text": "狂卖了超过200万册"
 },
 {
  "t": "07:19",
  "text": "最后这本风暴"
 },
 {
  "t": "07:21",
  "text": "洗选了中国大陆、台湾和日本"
 },
 {
  "t": "07:23",
  "text": "全亚洲的销量突破了数百万册"
 },
 {
  "t": "07:25",
  "text": "无数的千万别学英语实验班"
 },
 {
  "t": "07:27",
  "text": "盲听护住群在各大城市的大学如"
 },
 {
  "t": "07:29",
  "text": "雨后春损般的冒出来"
 },
 {
  "t": "07:31",
  "text": "那这次方法到底是谈话一线"
 },
 {
  "t": "07:33",
  "text": "还是长清的神话呢"
 },
 {
  "t": "07:35",
  "text": "从客观来说"
 },
 {
  "t": "07:37",
  "text": "它充满了极大的争议"
 },
 {
  "t": "07:39",
  "text": "当时无数传统英语老师也跳出来骂他"
 },
 {
  "t": "07:41",
  "text": "做他物人子弟"
 },
 {
  "t": "07:43",
  "text": "而且因为这个方法要求绝对不看字幕"
 },
 {
  "t": "07:45",
  "text": "绝对不查双语字典"
 },
 {
  "t": "07:47",
  "text": "过程实在是"
 },
 {
  "t": "07:48",
  "text": "太统骨和反人性了"
 },
 {
  "t": "07:50",
  "text": "导致中途放弃的失败者不计其数"
 },
 {
  "t": "07:52",
  "text": "但是最恐怖的地方就在这里"
 },
 {
  "t": "07:54",
  "text": "这个方法存在着极强的"
 },
 {
  "t": "07:56",
  "text": "性存者偏差"
 },
 {
  "t": "07:58",
  "text": "反而是那些真正咬牙熬过了黑暗期"
 },
 {
  "t": "08:00",
  "text": "严格执行了这套动作的人"
 },
 {
  "t": "08:02",
  "text": "几乎无意例外的都引来了"
 },
 {
  "t": "08:04",
  "text": "听力和口语的核爆级的肥月"
 },
 {
  "t": "08:06",
  "text": "那些成功者的反馈惊人的一致"
 },
 {
  "t": "08:08",
  "text": "就是有一天早上醒来"
 },
 {
  "t": "08:10",
  "text": "听英文广播"
 },
 {
  "t": "08:12",
  "text": "突然就不觉得那个是英文了"
 },
 {
  "t": "08:14",
  "text": "感觉就像在听母语一样"
 },
 {
  "t": "08:20",
  "text": "脑袋里连一丝翻译的痕迹都没有"
 },
 {
  "t": "08:22",
  "text": "为什么这套让无数人放�乞"
 },
 {
  "t": "08:24",
  "text": "却让无数人风神的办法"
 },
 {
  "t": "08:26",
  "text": "会有如此两极化的魔力量"
 },
 {
  "t": "08:28",
  "text": "接下来我们就要深入看到他的底层逻辑了"
 },
 {
  "t": "08:30",
  "text": "其实1984年"
 },
 {
  "t": "08:32",
  "text": "美国语言学家"
 },
 {
  "t": "08:34",
  "text": "优优独AUA语言中心"
 },
 {
  "t": "08:36",
  "text": "也启动了一个名为叫做ALG"
 },
 {
  "t": "08:38",
  "text": "Automatic Language Growth的实验计划"
 },
 {
  "t": "08:40",
  "text": "他找来了一群成年欧美人"
 },
 {
  "t": "08:42",
  "text": "把他们关在教室里面"
 },
 {
  "t": "08:44",
  "text": "规定极其变态就是"
 },
 {
  "t": "08:46",
  "text": "不准看课本、不准查字点、不准做笔记"
 },
 {
  "t": "08:48",
  "text": "甚至在第一年不准开口说话"
 },
 {
  "t": "08:50",
  "text": "这群成年人每天唯一要做的"
 },
 {
  "t": "08:52",
  "text": "就是坐在教室里面"
 },
 {
  "t": "08:54",
  "text": "看着两个泰国老师"
 },
 {
  "t": "08:56",
  "text": "在台上用纯泰语聊天"
 },
 {
  "t": "08:58",
  "text": "画图、表演短句"
 },
 {
  "t": "09:00",
  "text": "这个实验说只要你连续听完800个小时"
 },
 {
  "t": "09:02",
  "text": "这群老外就能自然然的讲出"
 },
 {
  "t": "09:04",
  "text": "毫无口音"
 },
 {
  "t": "09:05",
  "text": "像母语者一样流利的泰语"
 },
 {
  "t": "09:07",
  "text": "这期节目呢"
 },
 {
  "t": "09:08",
  "text": "我们之前有讲过"
 },
 {
  "t": "09:09",
  "text": "如果还没来得及看"
 },
 {
  "t": "09:10",
  "text": "可以去看一下"
 },
 {
  "t": "09:11",
  "text": "其实从那期节目以后"
 },
 {
  "t": "09:12",
  "text": "我要客观地告诉你"
 },
 {
  "t": "09:13",
  "text": "这个方法"
 },
 {
  "t": "09:14",
  "text": "被很多人喷是伪科学"
 },
 {
  "t": "09:16",
  "text": "为什么呢"
 },
 {
  "t": "09:17",
  "text": "确实有少数人实验成功了"
 },
 {
  "t": "09:19",
  "text": "但是绝"
 },
 {
  "t": "10:02",
  "text": "其实说用语当桥梁就绝对学不好"
 },
 {
  "t": "10:04",
  "text": "很多人用传统的方法"
 },
 {
  "t": "10:06",
  "text": "依然能够学得很霸肩"
 },
 {
  "t": "10:08",
  "text": "但是如果你能用科学的方法"
 },
 {
  "t": "10:10",
  "text": "能够戒断母语的中介"
 },
 {
  "t": "10:12",
  "text": "直接开始培养外语的直觉"
 },
 {
  "t": "10:14",
  "text": "你长出母语耳朵的效率"
 },
 {
  "t": "10:16",
  "text": "绝对会成指数级的翻倍"
 },
 {
  "t": "10:18",
  "text": "太过的实验之所以失败率高"
 },
 {
  "t": "10:21",
  "text": "是因为他少了一个让大脑"
 },
 {
  "t": "10:23",
  "text": "主动去异码声音的机制"
 },
 {
  "t": "10:25",
  "text": "受试者只能每天被动的"
 },
 {
  "t": "10:27",
  "text": "等着大脑自己开窍"
 },
 {
  "t": "10:29",
  "text": "这个太看天赋了"
 },
 {
  "t": "10:31",
  "text": "那么正在融的方法"
 },
 {
  "t": "10:33",
  "text": "之所以更加科学"
 },
 {
  "t": "10:35",
  "text": "更加容易被复制"
 },
 {
  "t": "10:37",
  "text": "就是因为他吸收了"
 },
 {
  "t": "10:39",
  "text": "不碰母语这个最大的优点"
 },
 {
  "t": "10:41",
  "text": "同时也会被招呼"
 },
 {
  "t": "10:43",
  "text": "因为他只能够把自己的手"
 },
 {
  "t": "10:46",
  "text": "不碰母语这个最大的优点"
 },
 {
  "t": "10:48",
  "text": "同时也加入了一整套输出的动作"
 },
 {
  "t": "10:50",
  "text": "正在融不是让你傻傻做的那里"
 },
 {
  "t": "10:56",
  "text": "光是空听"
 },
 {
  "t": "10:58",
  "text": "他还要向你同一段录音"
 },
 {
  "t": "11:00",
  "text": "你要听十几遍"
 },
 {
  "t": "11:02",
  "text": "然后要把你所听大的声音"
 },
 {
  "t": "11:04",
  "text": "要拼写下来"
 },
 {
  "t": "11:06",
  "text": "最后还要去查纯外语的字典"
 },
 {
  "t": "11:08",
  "text": "他强迫你从被动接收白噪音"
 },
 {
  "t": "11:10",
  "text": "主动变成主动破解声音的密码"
 },
 {
  "t": "11:12",
  "text": "这也就是他在6个月内"
 },
 {
  "t": "11:14",
  "text": "他才有个盲听方法"
 },
 {
  "t": "11:16",
  "text": "就提供了一个值得研究的方向"
 },
 {
  "t": "11:18",
  "text": "他不是只是让自己"
 },
 {
  "t": "11:20",
  "text": "待在外语的环境里"
 },
 {
  "t": "11:22",
  "text": "他要求自己反复聆听"
 },
 {
  "t": "11:24",
  "text": "辨识声音"
 },
 {
  "t": "11:26",
  "text": "再利用纯外语来解释"
 },
 {
  "t": "11:28",
  "text": "逐步处理自己听不懂的部分"
 },
 {
  "t": "11:30",
  "text": "这个就把语言输入"
 },
 {
  "t": "11:32",
  "text": "变成了一个有明确目标的训练过程"
 },
 {
  "t": "11:34",
  "text": "你第一次听一段英文"
 },
 {
  "t": "11:36",
  "text": "可能只会抓住几个熟悉的单字"
 },
 {
  "t": "11:38",
  "text": "第二次"
 },
 {
  "t": "11:40",
  "text": "你开始发现某些单字其实是连在一起的"
 },
 {
  "t": "11:42",
  "text": "你必须要把耳朵听到了所有声音"
 },
 {
  "t": "11:44",
  "text": "转换成自己能记录下来的内容"
 },
 {
  "t": "11:46",
  "text": "最后你拿出英文、原文"
 },
 {
  "t": "11:48",
  "text": "一个地方一个地方的合对"
 },
 {
  "t": "11:50",
  "text": "这个时候你才能真正知道自己"
 },
 {
  "t": "11:52",
  "text": "哪里出错了"
 },
 {
  "t": "11:54",
  "text": "哪个单字不熟悉"
 },
 {
  "t": "11:56",
  "text": "是单字不熟悉"
 },
 {
  "t": "11:58",
  "text": "是发音和你想的不一样"
 },
 {
  "t": "12:00",
  "text": "还是联读让你把两个单字听成一个呢"
 },
 {
  "t": "12:02",
  "text": "或者是你明明认识每个单字"
 },
 {
  "t": "12:04",
  "text": "却没有办法在真实的语速下"
 },
 {
  "t": "12:06",
  "text": "把他们切分开来"
 },
 {
  "t": "12:08",
  "text": "总之就是听力的一些问题"
 },
 {
  "t": "12:10",
  "text": "当听负责让你直接面对声音"
 },
 {
  "t": "12:12",
  "text": "听血负责暴露你的问题"
 },
 {
  "t": "12:14",
  "text": "原文比对负责让你找到答案"
 },
 {
  "t": "12:16",
  "text": "把这三个步骤连在一起"
 },
 {
  "t": "12:18",
  "text": "才是构成一整套完整训练的流程"
 },
 {
  "t": "12:20",
  "text": "很多人认为"
 },
 {
  "t": "12:22",
  "text": "提高听力就是把英文听得越多越好"
 },
 {
  "t": "12:24",
  "text": "但如果你一直是重复同一种错误"
 },
 {
  "t": "12:26",
  "text": "却从来没有过找出自己的错"
 },
 {
  "t": "12:28",
  "text": "到底在哪里"
 },
 {
  "t": "12:30",
  "text": "那么再多的聆听"
 },
 {
  "t": "12:32",
  "text": "也有可能只是反复暴露同一个问题"
 },
 {
  "t": "12:34",
  "text": "所以真正有效的训练"
 },
 {
  "t": "12:36",
  "text": "需要你知道自己正在处理什么"
 },
 {
  "t": "12:38",
  "text": "你不只要让英文进入耳朵"
 },
 {
  "t": "12:40",
  "text": "你还要让自己知道�耳朵"
 },
 {
  "t": "12:42",
  "text": "究�"
 },
 {
  "t": "12:57",
  "text": "听懂英文和辨识英文声音"
 },
 {
  "t": "13:00",
  "text": "当成了同一件事了"
 },
 {
  "t": "13:02",
  "text": "事实上这两件事情并不完全相同"
 },
 {
  "t": "13:04",
  "text": "理解一段英文"
 },
 {
  "t": "13:06",
  "text": "这两件事是相关的工作"
 },
 {
  "t": "13:08",
  "text": "第一步是辨识声音"
 },
 {
  "t": "13:10",
  "text": "第二步是理解意思"
 },
 {
  "t": "13:12",
  "text": "当你听不懂一段英文的时候"
 },
 {
  "t": "13:14",
  "text": "不一定是单字量不够"
 },
 {
  "t": "13:16",
  "text": "也可能是你的大脑根本没有成功辨识出对方说的是哪些单字"
 },
 {
  "t": "13:18",
  "text": "比如说老外说"
 },
 {
  "t": "13:20",
  "text": "He should have gone to the hospital"
 },
 {
  "t": "13:22",
  "text": "你看着文字可能下一秒就能够理解"
 },
 {
  "t": "13:24",
  "text": "但是在真实的对话里面"
 },
 {
  "t": "13:26",
  "text": "这句话中的一些音可能会发生一些弱化"
 },
 {
  "t": "13:28",
  "text": "联音听起来更接近"
 },
 {
  "t": "13:30",
  "text": "比如说"
 },
 {
  "t": "13:32",
  "text": "如果你的听力经验主要来自于输面英文"
 },
 {
  "t": "13:34",
  "text": "你可能会很熟悉"
 },
 {
  "t": "13:36",
  "text": "should have gone"
 },
 {
  "t": "13:38",
  "text": "当他们在自然的雨流中连在一起的时候"
 },
 {
  "t": "13:40",
  "text": "你却不一定能够马上辨识出来"
 },
 {
  "t": "13:42",
  "text": "这个时候你遇到的问题"
 },
 {
  "t": "13:44",
  "text": "就不一定是单字量不足了"
 },
 {
  "t": "13:46",
  "text": "而是你还没有充分的熟悉这些单字"
 },
 {
  "t": "13:48",
  "text": "在课程中的声音形式"
 },
 {
  "t": "13:50",
  "text": "这个就像你认识每一位演员"
 },
 {
  "t": "13:52",
  "text": "也看过他们的照片"
 },
 {
  "t": "13:54",
  "text": "但是当他们全部换上戏服"
 },
 {
  "t": "13:56",
  "text": "站在舞台中央的时候"
 },
 {
  "t": "13:58",
  "text": "你还是需要一些时间才能够辨识出谁是谁"
 },
 {
  "t": "14:00",
  "text": "所以蒙听的第一个目标"
 },
 {
  "t": "14:02",
  "text": "不一定是立刻理解整句话"
 },
 {
  "t": "14:04",
  "text": "但如果你能够直接理解"
 },
 {
  "t": "14:06",
  "text": "说明你的音域已经到了一丁水平了"
 },
 {
  "t": "14:08",
  "text": "而是先要注意这几句话"
 },
 {
  "t": "14:10",
  "text": "有几个声音区块"
 },
 {
  "t": "14:12",
  "text": "如果我能够在一周里逃走"
 },
 {
  "t": "14:14",
  "text": "我会有什么意义"
 },
 {
  "t": "14:16",
  "text": "有多少时间在逃走"
 },
 {
  "t": "14:18",
  "text": "呃 基本上没有人可以逃走"
 },
 {
  "t": "14:20",
  "text": "我"
 },
 {
  "t": "14:21",
  "text": "我说我妈妈"
 },
 {
  "t": "14:23",
  "text": "呃"
 },
 {
  "t": "14:25",
  "text": "因为你真的要爱它"
 },
 {
  "t": "14:27",
  "text": "你真的要被投入"
 },
 {
  "t": "14:29",
  "text": "因为不然它会被杀掉"
 },
 {
  "t": "14:42",
  "text": "更多原本模糊的细节"
 },
 {
  "t": "14:44",
  "text": "这个时候最重要的不是把音档放在旁边"
 },
 {
  "t": "14:47",
  "text": "而是机械式的播放到很多遍"
 },
 {
  "t": "14:49",
  "text": "比如说播放个100遍"
 },
 {
  "t": "14:51",
  "text": "而是每次聆听都带着一个明确的目标"
 },
 {
  "t": "14:54",
  "text": "第一次要听整体的节奏"
 },
 {
  "t": "14:56",
  "text": "第二次注意句子之间的停顿"
 },
 {
  "t": "14:58",
  "text": "第三次开始辩认熟悉的单字"
 },
 {
  "t": "15:00",
  "text": "最后呢"
 },
 {
  "t": "15:01",
  "text": "再把注意力集中在自己始终听不清楚的地方"
 },
 {
  "t": "15:05",
  "text": "所以你会逐渐发现"
 },
 {
  "t": "15:07",
  "text": "原本听起来像一整串杂音的英文"
 },
 {
  "t": "15:09",
  "text": "其实可以拆成一个一个可以辨识的声音区块"
 },
 {
  "t": "15:12",
  "text": "之后又让我想起了一个谁"
 },
 {
  "t": "15:14",
  "text": "Gabriel Weiner"
 },
 {
  "t": "15:15",
  "text": "就是那个学歌剧来学外语的人"
 },
 {
  "t": "15:17",
  "text": "他们学歌剧的时候"
 },
 {
  "t": "15:18",
  "text": "老师也是让他们去把每一个音都辨识出来"
 },
 {
  "t": "15:21",
  "text": "你只有辨识清楚了你才能够发清楚"
 },
 {
  "t": "15:23",
  "text": "OK 我们接着聊"
 },
 {
  "t": "15:24",
  "text": "所以把每一个音档拆成一个一个可以辨识的声音区块"
 },
 {
  "t": "15:28",
  "text": "就是盲听训练的第一个突破口"
 },
 {
  "t": "15:30",
  "text": "接下来才是停写"
 },
 {
  "t": "15:32",
  "text": "当你把自己听到的声音写下来"
 },
 {
  "t": "15:34",
